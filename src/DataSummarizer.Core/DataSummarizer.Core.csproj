<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Namespace for now, can change later -->
    <RootNamespace>Mostlylucid.DocSummarizer.Data</RootNamespace>
    <AssemblyName>DataSummarizer.Core</AssemblyName>

    <!-- Package metadata -->
    <PackageId>DataSummarizer.Core</PackageId>
    <Description>Core data file processing pipeline for CSV, JSON, Excel, Parquet, and SQLite database ingestion with relationship detection</Description>
    <Authors>Scott Galloway</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/scottgal/lucidrag</PackageProjectUrl>
    <RepositoryUrl>https://github.com/scottgal/lucidrag</RepositoryUrl>
    <PackageTags>data;csv;json;excel;parquet;sqlite;database;ingestion;etl</PackageTags>
  </PropertyGroup>

  <!-- Release configuration: no PDB files -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core dependencies -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.2" />

    <!-- CSV parsing -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />

    <!-- Excel support -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />

    <!-- Parquet support -->
    <PackageReference Include="Parquet.Net" Version="5.1.0" />

    <!-- DuckDB for ephemeral streaming analytics -->
    <PackageReference Include="DuckDB.NET.Data" Version="1.4.4-alpha.2" />

    <!-- Statistics library -->
    <PackageReference Include="MathNet.Numerics" Version="6.0.0-beta2" />

    <!-- SQLite database support -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.4" />

    <!-- Access database support - commented out until MMKiwi.MdbReader API stabilizes
    <PackageReference Include="MMKiwi.MdbReader" Version="0.1.0-beta1" />
    -->
  </ItemGroup>

  <ItemGroup>
    <!-- Common pipeline abstractions -->
    <ProjectReference Include="..\Mostlylucid.Summarizer.Core\Mostlylucid.Summarizer.Core.csproj" />
  </ItemGroup>

</Project>
