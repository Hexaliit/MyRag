<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>DoomSummarizer</RootNamespace>
        <Version>0.6.1</Version>
        <Authors>Scott Galloway</Authors>
        <Description>Core signal extraction pipeline: embeddings, entities, knowledge graphs, ranking, LLM integration</Description>

        <!-- Allow unsafe for ONNX -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Enable test access to internal members -->
    <ItemGroup>
        <InternalsVisibleTo Include="DoomSummarizer.Tests" />
        <InternalsVisibleTo Include="doomsummarizer" />
        <InternalsVisibleTo Include="DoomWriter" />
    </ItemGroup>

    <!-- Core dependencies -->
    <ItemGroup>
        <PackageReference Include="Fluid.Core" Version="2.31.0" />
        <PackageReference Include="Lucene.Net" Version="4.8.0-beta00017" />
        <PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00017" />
        <PackageReference Include="Lucene.Net.QueryParser" Version="4.8.0-beta00017" />
        <PackageReference Include="Microsoft.Recognizers.Text.DateTime" Version="1.8.13" />
        <PackageReference Include="Microsoft.Recognizers.Text.Number" Version="1.8.13" />
        <PackageReference Include="Microsoft.Recognizers.Text.Sequence" Version="1.8.13" />
        <PackageReference Include="ReverseMarkdown" Version="5.0.0" />
        <PackageReference Include="SmartReader" Version="0.11.0" />

        <!-- SQLite (metadata) -->
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.2" />

        <!-- DuckDB with VSS for HNSW vector search -->
        <PackageReference Include="DuckDB.NET.Data.Full" Version="1.4.4-alpha.2" />

        <!-- ONNX for local embeddings with GPU auto-detection -->
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.0" />
        <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.23.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
        <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />

        <!-- HTML parsing -->
        <PackageReference Include="AngleSharp" Version="1.4.1-beta.506" />

        <!-- Markdown generation -->
        <PackageReference Include="Markdig" Version="0.44.0" />

        <!-- Polly for resilience -->
        <PackageReference Include="Polly.Core" Version="8.6.5" />

        <!-- YAML config -->
        <PackageReference Include="YamlDotNet" Version="16.3.0" />

        <!-- Logging abstraction -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    </ItemGroup>

    <!-- Project references -->
    <ItemGroup>
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.Core\Mostlylucid.DocSummarizer.Core.csproj" />
    </ItemGroup>

    <!-- Playwright for WebsiteFetcher (JS-rendered sites) -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Playwright" Version="1.57.0" />
    </ItemGroup>

    <!-- Embed prompt templates and config -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\default-config.json" />
        <EmbeddedResource Include="Resources\sources.yaml" />
        <EmbeddedResource Include="Resources\prompts\*.txt" />
    </ItemGroup>

</Project>
