{
  "sources": {
    "hackerNews": {
      "enabled": true,
      "sections": [
        "top",
        "best",
        "new"
      ],
      "maxStories": 30,
      "minScore": 50
    },
    "reddit": {
      "enabled": true,
      "subreddits": [
        "programming",
        "csharp",
        "dotnet",
        "ExperiencedDevs",
        "technology"
      ],
      "sort": "hot",
      "maxPosts": 25,
      "minScore": 20
    },
    "websites": []
  },
  "sourceFilter": {
    "allowedDomains": [],
    "blockedDomains": [],
    "weights": {
      "reuters": 1.4,
      "bbc": 1.3,
      "guardian": 1.2,
      "ars": 1.2,
      "hn": 1.1,
      "arxiv": 1.3,
      "reddit": 0.9,
      "search": 0.8,
