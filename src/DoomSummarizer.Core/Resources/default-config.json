      "jina": 0.9,
      "currents": 1.0
    }
  },
  "ollama": {
    "baseUrl": "http://localhost:11434",
    "model": "gemma3:4b",
    "sentinelModel": "qwen3:0.6b",
    "embedModel": "nomic-embed-text",
    "temperature": 0.4,
    "timeoutSeconds": 300,
    "contextSize": 8192,
    "sentinelContextSize": 32768
  },
  "embedding": {
    "backend": "onnx",
    "model": "all-MiniLM-L6-v2",
    "similarityThreshold": 0.95
  },
  "output": {
    "format": "markdown",
    "maxSummaryLength": 500,
    "includeLinks": true,
    "groupByTopic": true
  },
  "linkFollowing": {
    "enabled": true,
    "maxLinksPerArticle": 3,
    "maxTotalLinks": 15,
    "maxContentLength": 2000,
    "timeoutSeconds": 10,
    "blockedDomains": [
      "facebook.com",
      "twitter.com",
      "x.com",
      "instagram.com",
      "linkedin.com",
      "youtube.com",
      "tiktok.com",
      "accounts.google.com",
      "play.google.com",
      "apps.apple.com"
    ],
    "blockedExtensions": [
      ".pdf",
      ".zip",
      ".tar",
      ".gz",
      ".exe",
      ".dmg",
      ".png",
      ".jpg",
      ".jpeg",
      ".gif",
      ".svg",
      ".webp",
      ".mp3",
      ".mp4",
      ".mov",
      ".avi",
      ".mkv"
