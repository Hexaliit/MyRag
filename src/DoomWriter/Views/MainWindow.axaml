<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DoomWriter.ViewModels"
        xmlns:views="using:DoomWriter.Views"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="DoomWriter.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                Padding="8,4">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Left: File + Panel controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                    <Button Classes="toolbar-icon-btn" Name="BtnNew"
                            ToolTip.Tip="New Document (Ctrl+N)">
                        <mi:MaterialIcon Kind="FilePlusOutline" />
                    </Button>
                    <Button Classes="toolbar-icon-btn" Name="BtnOpen"
                            ToolTip.Tip="Open File (Ctrl+O)">
                        <mi:MaterialIcon Kind="FolderOpenOutline" />
                    </Button>
                    <Button Classes="toolbar-icon-btn" Name="BtnSave"
                            ToolTip.Tip="Save (Ctrl+S)">
                        <mi:MaterialIcon Kind="ContentSaveOutline" />
                    </Button>
                    <Button Classes="toolbar-icon-btn" Name="BtnSaveAs"
                            ToolTip.Tip="Save As (Ctrl+Shift+S)">
                        <mi:MaterialIcon Kind="ContentSaveEditOutline" />
                    </Button>

                    <Border Width="1" Height="20"
                            Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                            Margin="6,0" />

                    <ToggleButton Classes="toolbar-icon-btn"
                                  IsChecked="{Binding IsSignalPanelVisible}"
                                  ToolTip.Tip="Toggle Signal Panel">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <mi:MaterialIcon Kind="ChartTimelineVariantShimmer" />
                            <TextBlock Text="Signals" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <!-- Center: Title -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />

                <!-- Right: Corpus, Settings, Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="toolbar-icon-btn" Name="BtnCorpus"
                            ToolTip.Tip="Manage corpus knowledge base">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <mi:MaterialIcon Kind="BookOpenPageVariantOutline" />
                            <TextBlock Text="Corpus" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Classes="toolbar-icon-btn" Name="BtnSettings"
                            ToolTip.Tip="Settings">
                        <mi:MaterialIcon Kind="CogOutline" />
                    </Button>

                    <Border Width="1" Height="20"
                            Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                            Margin="4,0" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Panel Width="8" Height="8">
                            <Ellipse Width="8" Height="8" Fill="#22C55E"
                                     IsVisible="{Binding IsOllamaConnected}" />
                            <Ellipse Width="8" Height="8" Fill="#EF4444"
                                     IsVisible="{Binding !IsOllamaConnected}" />
                        </Panel>
                        <TextBlock Text="Ollama" FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4"
                                IsVisible="{Binding IsGenerating}">
                        <TextBlock Text="{Binding GeneratingStatus}" FontSize="11"
                                   Foreground="#F59E0B" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content: Signal Panel + Splitter + Editor -->
        <Grid Grid.Row="1" Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="500" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Signal Panel (Left) -->
            <Border Grid.Column="0"
                    IsVisible="{Binding IsSignalPanelVisible}">
                <views:SignalPanel DataContext="{Binding SignalPanel}" />
            </Border>

            <!-- Drag splitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          Background="Transparent"
                          IsVisible="{Binding IsSignalPanelVisible}"
                          ResizeDirection="Columns" />

            <!-- Editor fills remaining space -->
            <Border Grid.Column="2"
                    Background="#1e1e1e"
                    Name="EditorContainer">
                <TextBlock Text="Loading editor..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#888888"
                           FontSize="14"
                           Name="EditorPlaceholder" />
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                Classes="status-bar"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Left: Metrics -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                    <TextBlock Classes="status-text">
                        <Run Text="words: " Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <Run Text="{Binding WordCount}" />
                    </TextBlock>
                    <TextBlock Classes="status-text">
                        <Run Text="segments: " Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <Run Text="{Binding SegmentCount}" />
                    </TextBlock>
                    <TextBlock Classes="status-text">
                        <Run Text="entities: " Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <Run Text="{Binding EntityCount}" />
                    </TextBlock>
                    <TextBlock Classes="status-text"
                               IsVisible="{Binding DominantTopic, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Run Text="topic: " Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <Run Text="{Binding DominantTopic}" />
                    </TextBlock>
                    <TextBlock Classes="status-text">
                        <Run Text="drift: " Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <Run Text="{Binding DriftScore, StringFormat='{}{0:F2}'}" />
                    </TextBlock>
                </StackPanel>

                <!-- Right: Analysis spinner -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsAnalyzing}">
                    <TextBlock Classes="status-text" Text="Analyzing..."
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- Keyboard shortcuts (file dialogs handled in code-behind) -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveFileCommand}" />
    </Window.KeyBindings>
</Window>