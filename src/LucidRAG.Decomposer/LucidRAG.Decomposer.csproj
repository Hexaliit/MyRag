<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>LucidRAG.Decomposer</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <!-- Enable test access to internal members -->
    <ItemGroup>
        <InternalsVisibleTo Include="DoomSummarizer.Tests" />
    </ItemGroup>

    <!-- DocSummarizer.Core for IEmbeddingService + NER types -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.Core\Mostlylucid.DocSummarizer.Core.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.DocSummarizer" Version="$(CorePackageVersion)" />
    </ItemGroup>

    <!-- Logging -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
    </ItemGroup>

    <!-- YAML for glossary -->
    <ItemGroup>
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>

    <!-- Embed glossary files -->
    <ItemGroup>
        <EmbeddedResource Include="Glossary\glossary.yaml" />
    </ItemGroup>

</Project>
