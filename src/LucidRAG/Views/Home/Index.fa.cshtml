                getCommunityColor(comm) {
                    // Generate consistent color based on community id
                    if (!comm || !comm.id) return '#6b7280';
                    const hash = comm.id.split('').reduce((acc, char) => char.charCodeAt(0) + acc, 0);
                    const hue = hash % 360;
                    return `hsl(${hue}, 65%, 50%)`;
