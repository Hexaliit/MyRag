                async loadGraphData() {
                    if (this.graphLoading) return;
                    this.graphLoading = true;
                    try {
                        const response = await fetch('/api/graph?maxNodes=100');
                        if (response.ok) {
                            const data = await response.json();
                            // Normalize API response to graphData format
                            this.graphData = {
                                nodes: data.nodes || [],
                                links: data.links || [],
                                entities: (data.nodes || []).map(n => ({
                                    id: n.id,
                                    name: n.name,
                                    type: n.type,
                                    description: n.description,
                                    score: n.mentionCount ? n.mentionCount / 100 : 0
                                })),
                                paths: []
                            };
                            this.$nextTick(() => this.renderGraph());
                        }
                    } catch (e) {
                        console.warn('Could not load graph data:', e);
                    } finally {
                        this.graphLoading = false;
                    }
                },

                async loadSubgraph(entityId) {
                    if (!entityId || this.graphLoading) return;
                    this.graphLoading = true;
                    try {
                        const params = new URLSearchParams({
                            maxHops: this.graphSettings.maxHops || 2,
                            edgeFilter: this.graphSettings.edgeFilter || 'all'
                        });
                        const response = await fetch(`/api/graph/subgraph/${entityId}?${params}`);
                        if (response.ok) {
                            const data = await response.json();
                            this.graphData = {
                                nodes: data.nodes || [],
                                links: (data.links || []).map(l => ({
                                    source: l.source,
                                    target: l.target,
                                    type: l.type,
                                    strength: l.strength
                                })),
                                entities: (data.nodes || []).map(n => ({
                                    id: n.id,
                                    name: n.name,
                                    type: n.type,
                                    description: n.description,
                                    score: n.isCenter ? 1 : 0.5
                                })),
                                paths: []
                            };
                            this.$nextTick(() => this.renderGraph());
                        }
                    } catch (e) {
                        console.warn('Could not load subgraph:', e);
                    } finally {
                        this.graphLoading = false;
                    }
                },

                renderGraph() {
                    const container = this.$refs.graphCanvas;
                    if (!container || !this.graphData) return;

                    const width = container.clientWidth;
                    const height = container.clientHeight || 384;

                    // Clear previous graph
                    container.innerHTML = '';

                    const { nodes, links } = this.graphData;
                    if (!nodes || nodes.length === 0) return;

                    // Colors by entity type
                    const typeColors = {
                        person: '#3b82f6',
                        organization: '#10b981',
                        location: '#ef4444',
                        concept: '#8b5cf6',
                        event: '#f59e0b',
                        date: '#6b7280',
                        class: '#3b82f6',
                        function: '#10b981',
                        method: '#8b5cf6',
                        property: '#f59e0b',
                        default: '#6b7280'
                    };

                    const getColor = (type) => typeColors[type?.toLowerCase()] || typeColors.default;

                    // Create SVG
                    const svg = d3.select(container)
                        .append('svg')
                        .attr('width', width)
                        .attr('height', height)
                        .style('cursor', 'grab');

                    // Define arrow marker for links
                    svg.append('defs').append('marker')
                        .attr('id', 'arrow')
                        .attr('viewBox', '0 -5 10 10')
                        .attr('refX', 20)
                        .attr('refY', 0)
                        .attr('markerWidth', 6)
                        .attr('markerHeight', 6)
                        .attr('orient', 'auto')
                        .append('path')
                        .attr('d', 'M0,-5L10,0L0,5')
                        .attr('fill', '#999');

                    // Filter links based on edgeFilter
                    const edgeFilter = this.graphSettings.edgeFilter || 'all';
                    const activeLinks = edgeFilter === 'all'
                        ? links
                        : links.filter(l => l.type === edgeFilter);

                    // Collect node IDs that are part of active links (plus all nodes)
                    const activeNodeIds = new Set(nodes.map(n => n.id));
                    activeLinks.forEach(l => {
                        const sId = typeof l.source === 'object' ? l.source.id : l.source;
                        const tId = typeof l.target === 'object' ? l.target.id : l.target;
                        activeNodeIds.add(sId);
                        activeNodeIds.add(tId);
                    });

                    const activeNodes = nodes.filter(n => activeNodeIds.has(n.id));

                    // Create zoom behavior
                    const zoom = d3.zoom()
                        .scaleExtent([0.1, 4])
                        .on('zoom', (event) => {
                            g.attr('transform', event.transform);
                        });

                    svg.call(zoom);

                    // Main group for zoom/pan
                    const g = svg.append('g');

                    // Create links
                    const linkGroup = g.append('g').attr('class', 'links');
                    const linkElements = linkGroup.selectAll('g.link-group')
                        .data(activeLinks)
                        .enter()
                        .append('g')
                        .attr('class', 'link-group');

                    const linkLines = linkElements.append('line')
                        .attr('stroke', '#999')
                        .attr('stroke-opacity', 0.6)
                        .attr('stroke-width', d => Math.max(0.5, Math.min(3, (d.strength || 0.5) * 3)))
                        .attr('marker-end', 'url(#arrow)');

                    // Link labels
                    const linkLabels = linkElements.append('text')
                        .attr('font-size', '8px')
                        .attr('fill', '#999')
                        .attr('text-anchor', 'middle')
                        .attr('dy', '-4')
                        .text(d => d.type || '');

                    // Create nodes
                    const nodeGroup = g.append('g').attr('class', 'nodes');
                    const nodeElements = nodeGroup.selectAll('g.node-group')
                        .data(activeNodes)
                        .enter()
                        .append('g')
                        .attr('class', 'node-group')
                        .style('cursor', 'pointer')
                        .on('click', (event, d) => {
                            event.stopPropagation();
                            this.loadSubgraph(d.id);
                        })
                        .call(d3.drag()
                            .on('start', (event, d) => {
                                if (!event.active) simulation.alphaTarget(0.3).restart();
                                d.fx = d.x;
                                d.fy = d.y;
                            })
                            .on('drag', (event, d) => {
                                d.fx = event.x;
                                d.fy = event.y;
                            })
                            .on('end', (event, d) => {
                                if (!event.active) simulation.alphaTarget(0);
                                d.fx = null;
                                d.fy = null;
                            })
                        );

                    // Node circles
                    nodeElements.append('circle')
                        .attr('r', d => Math.max(5, Math.min(15, (d.mentionCount || 1) * 0.5)))
                        .attr('fill', d => getColor(d.type))
                        .attr('stroke', '#fff')
                        .attr('stroke-width', 1.5);

                    // Node labels
                    nodeElements.append('text')
                        .attr('dx', d => Math.max(5, Math.min(15, (d.mentionCount || 1) * 0.5)) + 4)
                        .attr('dy', 4)
                        .attr('font-size', '10px')
                        .attr('fill', '#333')
                        .text(d => d.name || '');

                    // Node type badges (small text below label)
                    nodeElements.append('text')
                        .attr('dx', d => Math.max(5, Math.min(15, (d.mentionCount || 1) * 0.5)) + 4)
                        .attr('dy', 14)
                        .attr('font-size', '7px')
                        .attr('fill', '#999')
                        .text(d => d.type || '');

                    // Force simulation
                    const simulation = d3.forceSimulation(activeNodes)
                        .force('link', d3.forceLink(activeLinks)
                            .id(d => d.id)
                            .distance(100)
                        )
                        .force('charge', d3.forceManyBody().strength(-300))
                        .force('center', d3.forceCenter(width / 2, height / 2))
                        .force('collision', d3.forceCollide().radius(30))
                        .on('tick', () => {
                            linkLines
                                .attr('x1', d => d.source.x)
                                .attr('y1', d => d.source.y)
                                .attr('x2', d => d.target.x)
                                .attr('y2', d => d.target.y);

                            linkLabels
                                .attr('x', d => (d.source.x + d.target.x) / 2)
                                .attr('y', d => (d.source.y + d.target.y) / 2);

                            nodeElements
                                .attr('transform', d => `translate(${d.x},${d.y})`);
                        });

                    // Legend
                    const types = [...new Set(activeNodes.map(n => n.type?.toLowerCase()).filter(Boolean))];
                    const legend = svg.append('g')
                        .attr('transform', `translate(${width - 120}, 10)`);

                    types.slice(0, 8).forEach((type, i) => {
                        const row = legend.append('g')
                            .attr('transform', `translate(0, ${i * 18})`);

                        row.append('circle')
                            .attr('r', 4)
                            .attr('fill', getColor(type));

                        row.append('text')
                            .attr('x', 10)
                            .attr('y', 4)
                            .attr('font-size', '9px')
                            .attr('fill', '#666')
                            .text(type.charAt(0).toUpperCase() + type.slice(1));
                    });

                    // Double-click to reset zoom
                    svg.on('dblclick.zoom', null);
                    svg.on('dblclick', () => {
                        svg.transition().duration(500).call(zoom.transform, d3.zoomIdentity);
                    });
                },

                async uploadFiles(event) {
                    const files = event.target.files;
                    if (!files.length) return;

                    this.uploads = Array.from(files).map(f => ({
                        filename: f.name,
                        status: 'uploading'
                    }));

                    this.$refs.uploadModal.showModal();

                    for (let i = 0; i < files.length; i++) {
                        const file = files[i];
                        const formData = new FormData();
                        formData.append('file', file);

                        try {
                            const response = await fetch('/api/documents/upload', {
                                method: 'POST',
                                body: formData
                            });
                            const result = await response.json();

                            if (response.ok) {
                                this.uploads[i].status = 'queued';
                                this.uploads[i].documentId = result.documentId;
                            } else {
                                this.uploads[i].status = 'error';
                                this.uploads[i].error = result.error;
                            }
                        } catch (e) {
                            this.uploads[i].status = 'error';
                            this.uploads[i].error = e.message;
                        }
                    }

                    htmx.trigger(document.body, 'documentUploaded');
                    this.loadGraphStats();
                    event.target.value = '';
                },

                closeUploadModal() {
                    this.$refs.uploadModal.close();
                    this.uploads = [];
                },

                async uploadFolder(event) {
                    const files = event.target.files;
                    if (!files || files.length === 0) return;

                    // Filter to supported file types
                    const supportedExtensions = ['.pdf', '.docx', '.doc', '.md', '.markdown', '.txt', '.html', '.htm',
                        '.png', '.jpg', '.jpeg', '.gif', '.webp', '.bmp', '.tiff', '.tif',
                        '.csv', '.xlsx', '.xls', '.json', '.parquet'];
                    const filteredFiles = Array.from(files).filter(f => {
                        const ext = '.' + f.name.split('.').pop().toLowerCase();
                        return supportedExtensions.includes(ext);
                    });

                    if (filteredFiles.length === 0) {
                        alert('فایل پشتیبانی شده‌ای در پوشه انتخاب شده یافت نشد.\n\nپشتیبانی شده: PDF, DOCX, MD, TXT, HTML, images, CSV, XLSX, JSON, Parquet');
                        event.target.value = '';
                        return;
                    }

                    // Show upload progress
                    this.uploads = filteredFiles.map(f => ({
                        filename: f.webkitRelativePath || f.name,
                        status: 'pending'
                    }));
                    this.$refs.uploadModal.showModal();

                    // Get folder base path from first file
                    const firstPath = filteredFiles[0].webkitRelativePath || '';
                    const folderName = firstPath.split('/')[0] || 'uploaded';

                    // Upload files in batches (parallel within batch, sequential batches)
                    const batchSize = 5;
                    for (let i = 0; i < filteredFiles.length; i += batchSize) {
                        const batch = filteredFiles.slice(i, Math.min(i + batchSize, filteredFiles.length));

                        await Promise.all(batch.map(async (file, batchIndex) => {
                            const fileIndex = i + batchIndex;
                            const relativePath = file.webkitRelativePath || file.name;
                            this.uploads[fileIndex].status = 'uploading';

                            const formData = new FormData();
                            formData.append('file', file);
                            formData.append('sourcePath', relativePath);
                            if (this.currentCollectionId) {
                                formData.append('collectionId', this.currentCollectionId);
                            }

                            try {
                                const response = await fetch('/api/documents/import', {
                                    method: 'POST',
                                    body: formData
                                });
                                const result = await response.json();

                                if (response.ok) {
                                    this.uploads[fileIndex].status = result.action === 'unchanged' ? 'skipped' : 'queued';
                                    this.uploads[fileIndex].documentId = result.documentId;
                                    this.uploads[fileIndex].action = result.action;
                                } else {
                                    this.uploads[fileIndex].status = 'error';
                                    this.uploads[fileIndex].error = result.error || 'بارگذاری ناموفق';
                                }
                            } catch (e) {
                                this.uploads[fileIndex].status = 'error';
                                this.uploads[fileIndex].error = e.message;
                            }
                        }));
                    }

                    // Refresh document list and stats
                    htmx.trigger(document.body, 'documentUploaded');
                    this.loadGraphStats();
                    event.target.value = '';

                    // Show summary
                    const created = this.uploads.filter(u => u.action === 'created').length;
                    const updated = this.uploads.filter(u => u.action === 'updated').length;
                    const unchanged = this.uploads.filter(u => u.status === 'skipped').length;
                    const errors = this.uploads.filter(u => u.status === 'error').length;

                    console.log(`Folder upload complete: ${created} created, ${updated} updated, ${unchanged} unchanged, ${errors} errors`);
                },

