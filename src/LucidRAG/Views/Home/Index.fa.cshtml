                async sendMessage() {
                    const query = this.currentMessage.trim();
                    if (!query) return;

                    const userMsg = {
                        id: Date.now(),
                        role: 'user',
                        content: query,
                        timestamp: new Date().toISOString()
                    };
                    this.messages.push(userMsg);
                    this.currentMessage = '';
                    this.isTyping = true;
                    this.streamingThinking = null;
                    this.lastAnswer = null;
                    this.selectedSentence = null;
                    this.selectedEvidence = [];
                    this.graphData = null;
                    this.debugInfo = null;

                    // Create placeholder message for streaming
                    const assistantMsgId = Date.now() + 1;
                    const assistantMsg = {
                        id: assistantMsgId,
                        role: 'assistant',
                        content: '',
                        sources: [],
                        timestamp: new Date().toISOString(),
                        isStreaming: true
                    };
                    this.messages.push(assistantMsg);

                    this.$nextTick(() => {
                        if (this.$refs.chatMessages) {
                            this.$refs.chatMessages.scrollTop = this.$refs.chatMessages.scrollHeight;
                        }
                    });

                    const startTime = Date.now();

                    try {
                        // Use streaming endpoint to show sources early
                        const response = await fetch('/api/chat/stream-with-sources', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({
                                query,
                                conversationId: this.conversationId,
                                documentIds: this.selectedDocIds.size > 0 ? Array.from(this.selectedDocIds) : null,
                                searchMode: this.searchMode
                            })
                        });

                        const reader = response.body.getReader();
                        const decoder = new TextDecoder();
                        let buffer = '';
                        let fullAnswer = '';
                        let sources = [];
                        let thinkingNote = null;
                        let searchTimeMs = 0;
                        let segmentCount = 0;

                        while (true) {
                            const {done, value} = await reader.read();
                            if (done) break;

                            buffer += decoder.decode(value, {stream: true});
                            const lines = buffer.split('\n');
                            buffer = lines.pop(); // Keep incomplete line in buffer

                            for (const line of lines) {
                                if (!line.startsWith('data: ')) continue;
                                const data = line.slice(6);
                                if (data === '[DONE]') continue;

                                try {
                                    const chunk = JSON.parse(data);

                                    if (chunk.type === 'sources' && chunk.sources) {
                                        // Show sources immediately!
                                        sources = chunk.sources;
                                        const msgIdx = this.messages.findIndex(m => m.id === assistantMsgId);
                                        if (msgIdx >= 0) {
                                            this.messages[msgIdx].sources = sources;
                                        }
                                        // Store for evidence view
                                        this.lastAnswer = {
                                            fullText: '',
                                            sentences: [],
                                            sources: sources
                                        };
                                        this.selectedEvidence = sources.length > 0 ? [sources[0]] : [];

                                        // Update metadata
                                        if (chunk.conversationId) {
                                            this.conversationId = chunk.conversationId;
                                            this.setCookie('lucidrag-conversation', chunk.conversationId);
                                        }
                                        if (chunk.thinkingNote) {
                                            thinkingNote = chunk.thinkingNote;
                                            // Show compact thinking note during stream
                                            this.streamingThinking = chunk.thinkingNote.split('\n')[0].substring(0, 100);
                                        }
                                        if (chunk.searchTimeMs) searchTimeMs = chunk.searchTimeMs;
                                        if (chunk.segmentCount) segmentCount = chunk.segmentCount;
                                    }

                                    if (chunk.type === 'text' && chunk.text) {
                                        fullAnswer += chunk.text;
                                        const msgIdx = this.messages.findIndex(m => m.id === assistantMsgId);
                                        if (msgIdx >= 0) {
                                            this.messages[msgIdx].content = fullAnswer;
                                        }
                                        // Auto-scroll
                                        this.$nextTick(() => {
                                            if (this.$refs.chatMessages) {
                                                this.$refs.chatMessages.scrollTop = this.$refs.chatMessages.scrollHeight;
                                            }
                                        });
                                    }

                                    if (chunk.type === 'done') {
                                        // Finalize message
                                        const msgIdx = this.messages.findIndex(m => m.id === assistantMsgId);
                                        if (msgIdx >= 0) {
                                            this.messages[msgIdx].isStreaming = false;
                                            this.messages[msgIdx].thinkingNote = thinkingNote;
                                            this.messages[msgIdx].searchTimeMs = searchTimeMs;
                                            this.messages[msgIdx].segmentCount = segmentCount;
                                        }

                                        // Parse for evidence view
                                        this.lastAnswer = this.parseAnswerForEvidence({
                                            answer: fullAnswer,
                                            sources: sources
                                        });

                                        // Store debug info
                                        this.debugInfo = {
                                            queryEntities: [],
                                            missingEntities: [],
                                            suggestion: null,
                                            latencyMs: Date.now() - startTime,
                                            retrievalHits: sources.length,
                                            graphExpansions: 0
                                        };

                                        // Pre-load graph data for Graph view
                                        this.loadGraphData();
                                    }
                                } catch (parseErr) {
                                    console.warn('Failed to parse SSE chunk:', parseErr);
                                }
                            }
                        }
                    } catch (e) {
                        const msgIdx = this.messages.findIndex(m => m.id === assistantMsgId);
                        if (msgIdx >= 0) {
                            this.messages[msgIdx].content = `خطا: ${e.message}`;
                            this.messages[msgIdx].isStreaming = false;
                        }
                    } finally {
                        this.isTyping = false;
                        this.streamingThinking = null;
                        this.$nextTick(() => {
                            if (this.$refs.chatMessages) {
                                this.$refs.chatMessages.scrollTop = this.$refs.chatMessages.scrollHeight;
                            }
                        });
                    }
                },

                parseAnswerForEvidence(result) {
                    const sentences = result.answer.split(/(?<=[.!?])\s+/).map((text, idx) => {
                        // Simple heuristic: check if sentence contains quoted text
                        const isDirectQuote = text.includes('"') || text.includes("'") || text.includes('`');

                        // Extract source references from brackets like [1], [2,3]
                        const sourceRefs = [];
                        const matches = text.matchAll(/\[(\d+(?:,\s*\d+)*)\]/g);
                        for (const match of matches) {
                            sourceRefs.push(...match[1].split(',').map(s => s.trim()));
                        }

                        return {
                            text: text.trim(),
                            isDirectQuote,
                            sourceRefs,
                            evidenceIds: sourceRefs.map(n => parseInt(n)).filter(n => !isNaN(n))
                        };
                    }).filter(s => s.text.length > 0);

                    return {
                        fullText: result.answer,
                        sentences,
                        sources: result.sources || []
                    };
                },

                selectSentence(idx) {
                    this.selectedSentence = idx;
                    const sentence = this.lastAnswer.sentences[idx];

                    // Find matching evidence based on source references
                    if (sentence.evidenceIds.length > 0 && this.lastAnswer.sources) {
                        this.selectedEvidence = this.lastAnswer.sources.filter(
                            s => sentence.evidenceIds.includes(s.number)
                        );
                    } else if (this.lastAnswer.sources && this.lastAnswer.sources.length > 0) {
                        // Show first source if no specific refs
                        this.selectedEvidence = [this.lastAnswer.sources[0]];
                    } else {
                        this.selectedEvidence = [];
                    }
                },

                showEvidence(source) {
                    this.viewMode = 'evidence';
                    this.selectedEvidence = [source];
                },

                // Audio evidence helper functions
                isAudioEvidence(type) {
                    const audioTypes = [
                        'stem_vocals', 'stem_drums', 'stem_bass', 'stem_other', 'stem_instrumentals',
                        'audio_waveform', 'speaker_sample', 'transcript'
                    ];
                    return audioTypes.includes(type) || type?.startsWith('stem_');
                },

                hasAudioStems(evidence) {
                    if (!evidence || !evidence.length) return false;
                    return evidence.some(e => e.type?.startsWith('stem_'));
                },

                getAudioStems(evidence) {
                    if (!evidence) return {};
                    const stems = {};
                    const stemTypes = {
                        'stem_vocals': 'vocals',
                        'stem_drums': 'drums',
                        'stem_bass': 'bass',
                        'stem_other': 'other',
                        'stem_instrumentals': 'instrumentals'
                    };
                    evidence.forEach(e => {
                        const stemName = stemTypes[e.type];
                        if (stemName) {
                            stems[stemName] = `/api/evidence/artifact/${e.id}/download`;
                        }
                    });
                    return stems;
                },

                toggleAudioPlay(btn, evidenceId) {
                    const player = window.AudioPlayer?.getPlayer('audio-' + evidenceId);
                    if (player) {
                        player.playPause();
                    }
                },

                showSegmentDetail(source) {
                    // Show the segment detail modal with source info
                    this.selectedSegment = source;
                    this.$refs.segmentModal.showModal();
                },

                closeSegmentModal() {
                    this.$refs.segmentModal.close();
                    this.selectedSegment = null;
                },

                async showDocumentDetails(documentId) {
                    this.documentDetails = null;
                    this.detailsTab = 'entities';
                    // Switch to details view
                    this.viewMode = 'details';

                    try {
                        const response = await fetch(`/api/documents/${documentId}/details`);
                        if (response.ok) {
                            this.documentDetails = await response.json();
                        } else {
                            console.error('Failed to load document details:', await response.text());
                            this.closeDocumentDetails();
                        }
                    } catch (e) {
                        console.error('Error loading document details:', e);
                        this.closeDocumentDetails();
                    }
                },

                closeDocumentDetails() {
                    this.documentDetails = null;
                    this.viewMode = 'answer'; // Return to chat view
                },

                async retryDocument(documentId) {
                    try {
                        const response = await fetch(`/api/documents/${documentId}/retry`, {method: 'POST'});
                        if (response.ok) {
                            // Refresh details
                            await this.showDocumentDetails(documentId);
                            // Refresh document list
                            htmx.trigger(document.body, 'documentUploaded');
                        }
                    } catch (e) {
                        console.error('Error retrying document:', e);
                    }
                },

                formatFileSize(bytes) {
                    if (!bytes) return '0 B';
                    const units = ['B', 'KB', 'MB', 'GB'];
                    let i = 0;
                    while (bytes >= 1024 && i < units.length - 1) {
                        bytes /= 1024;
                        i++;
                    }
                    return bytes.toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
                },

                getStatusBadgeClass(status) {
                    const classes = {
                        'completed': 'badge-success',
                        'processing': 'badge-info',
                        'pending': 'badge-warning',
                        'failed': 'badge-error',
                        'stuck': 'badge-error'
                    };
                    return classes[status?.toLowerCase()] || 'badge-ghost';
                },

                getEntityTypeBadge(type) {
                    const classes = {
                        'person': 'badge-primary',
                        'organization': 'badge-secondary',
                        'location': 'badge-accent',
                        'concept': 'badge-info',
                        'event': 'badge-warning',
                        'date': 'badge-neutral'
                    };
                    return classes[type?.toLowerCase()] || 'badge-ghost';
                },

                getSignalCategory(key) {
                    if (!key) return 'signal';
                    // Extract category from signal key (e.g., "document.topics" -> "document")
                    const parts = key.split('.');
                    if (parts.length > 1) return parts[0];
                    // Common signal prefixes
                    if (key.startsWith('ocr')) return 'ocr';
                    if (key.startsWith('vision')) return 'vision';
                    if (key.startsWith('audio')) return 'audio';
                    if (key.startsWith('video')) return 'video';
                    if (key.startsWith('data')) return 'data';
                    if (key.startsWith('table')) return 'table';
                    return 'signal';
                },

                formatSegmentText(text) {
                    if (!text) return '';
                    // Basic markdown-like formatting
                    return text
                        // Escape HTML
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        // Code blocks
                        .replace(/```(\w+)?\n([\s\S]*?)```/g, '<pre class="bg-base-300 p-2 rounded text-xs overflow-x-auto"><code>$2</code></pre>')
                        // Inline code
                        .replace(/`([^`]+)`/g, '<code class="bg-base-300 px-1 rounded text-sm">$1</code>')
                        // Bold
                        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
                        // Italic
                        .replace(/\*([^*]+)\*/g, '<em>$1</em>')
                        // Line breaks
                        .replace(/\n/g, '<br>');
                },

                selectEntity(entity) {
                    this.selectedEntity = entity;
                    // TODO: fetch supporting chunks for this entity
                },

                getEntityBadgeClass(type) {
                    const classes = {
                        'class': 'badge-primary',
                        'function': 'badge-secondary',
                        'person': 'badge-accent',
                        'org': 'badge-info',
                        'concept': 'badge-warning',
                        'default': 'badge-ghost'
                    };
                    return classes[type?.toLowerCase()] || classes.default;
                },

                async startCrawl() {
                    if (!this.crawlUrl || this.crawlInProgress) return;

                    this.crawlInProgress = true;
                    this.crawlProgress = null;

                    try {
                        const response = await fetch('/api/crawl', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({
                                seedUrls: [this.crawlUrl],
                                contentSelector: this.crawlSelector || null,
                                maxPages: this.crawlMaxPages,
                                maxDepth: this.crawlMaxDepth
                            })
                        });

                        if (!response.ok) {
                            const error = await response.json();
                            this.crawlProgress = {
                                status: 'failed',
                                errorMessage: error.error || 'شروع خزش ناموفق'
                            };
                            this.crawlInProgress = false;
                            return;
                        }

                        const result = await response.json();
                        const crawlId = result.crawlId;

                        // Connect to SSE for progress updates
                        this.crawlEventSource = new EventSource(`/api/crawl/${crawlId}/status`);

                        this.crawlEventSource.onmessage = (event) => {
                            const progress = JSON.parse(event.data);
                            this.crawlProgress = progress;

                            if (progress.status === 'completed' || progress.status === 'failed') {
                                this.crawlEventSource.close();
                                this.crawlEventSource = null;
                                this.crawlInProgress = false;

                                // Refresh document list
                                htmx.trigger(document.body, 'documentUploaded');
                                this.loadGraphStats();
                            }
                        };

                        this.crawlEventSource.onerror = () => {
                            this.crawlEventSource.close();
                            this.crawlEventSource = null;
                            this.crawlInProgress = false;
                            if (!this.crawlProgress || this.crawlProgress.status === 'crawling') {
                                this.crawlProgress = {status: 'failed', errorMessage: 'ارتباط قطع شد'};
                            }
                        };
                    } catch (e) {
                        this.crawlProgress = {status: 'failed', errorMessage: e.message};
                        this.crawlInProgress = false;
                    }
                }
            };
        }
    </script>
}
