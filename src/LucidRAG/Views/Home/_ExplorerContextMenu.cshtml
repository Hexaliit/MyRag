@* Explorer Context Menu - Right-click actions *@

<div x-show="contextMenu.show"
     x-cloak
     x-transition:enter="transition ease-out duration-100"
     x-transition:enter-start="opacity-0 scale-95"
     x-transition:enter-end="opacity-100 scale-100"
     x-transition:leave="transition ease-in duration-75"
     x-transition:leave-start="opacity-100 scale-100"
     x-transition:leave-end="opacity-0 scale-95"
     :style="`left: ${contextMenu.x}px; top: ${contextMenu.y}px;`"
     class="fixed z-50 menu bg-base-100 rounded-box shadow-xl border border-base-300 w-52 p-2"
     @@click.away="hideContextMenu()">

    <!-- Document actions -->
    <template x-if="contextMenu.type === 'doc'">
        <div>
            <li>
                <a @@click="openDocument(contextMenu.id); hideContextMenu()">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    View Details
                </a>
            </li>
            <li>
                <a @@click="selectedItems.clear(); selectedItems.add('doc:' + contextMenu.id); scopeChatToSelection(); hideContextMenu()">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                    </svg>
                    Chat with this
                </a>
            </li>
            <template x-if="canWrite">
                <div>
                    <div class="divider my-1"></div>
                    <li>
                        <a @@click="/* TODO: rename */ hideContextMenu()">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                            Rename
                        </a>
                    </li>
                    <li>
                        <a class="text-error" @@click="selectedItems.clear(); selectedItems.add('doc:' + contextMenu.id); deleteSelected(); hideContextMenu()">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                            Delete
                        </a>
                    </li>
                </div>
            </template>
        </div>
    </template>

    <!-- Folder actions -->
    <template x-if="contextMenu.type === 'folder'">
        <div>
            <li>
                <a @@click="navigateToFolder(contextMenu.id); hideContextMenu()">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                    </svg>
                    Open
                </a>
            </li>
            <template x-if="canWrite">
                <div>
                    <div class="divider my-1"></div>
                    <li>
                        <a @@click="/* TODO: rename folder */ hideContextMenu()">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                            Rename
                        </a>
                    </li>
                    <li>
                        <a class="text-error" @@click="selectedItems.clear(); selectedItems.add('folder:' + contextMenu.id); deleteSelected(); hideContextMenu()">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                            Delete
                        </a>
                    </li>
                </div>
            </template>
        </div>
    </template>

    <!-- Background/empty area actions -->
    <template x-if="!contextMenu.type">
        <div>
            <template x-if="canWrite">
                <div>
                    <li>
                        <a @@click="createFolder(); hideContextMenu()">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
                            </svg>
                            New Folder
                        </a>
                    </li>
                    <div class="divider my-1"></div>
                </div>
            </template>
            <li class="menu-title">
                <span>Sort by</span>
            </li>
            <li>
                <a @@click="setSortBy('name'); hideContextMenu()"
                   :class="sortBy === 'name' ? 'active' : ''">
                    Name
                </a>
            </li>
            <li>
                <a @@click="setSortBy('date'); hideContextMenu()"
                   :class="sortBy === 'date' ? 'active' : ''">
                    Date
                </a>
            </li>
            <li>
                <a @@click="setSortBy('size'); hideContextMenu()"
                   :class="sortBy === 'size' ? 'active' : ''">
                    Size
                </a>
            </li>
            <li>
                <a @@click="setSortBy('status'); hideContextMenu()"
                   :class="sortBy === 'status' ? 'active' : ''">
                    Status
                </a>
            </li>
            <div class="divider my-1"></div>
            <li class="menu-title">
                <span>View</span>
            </li>
            <li>
                <a @@click="setViewMode('list'); hideContextMenu()"
                   :class="viewMode === 'list' ? 'active' : ''">
                    List
                </a>
            </li>
            <li>
                <a @@click="setViewMode('grid'); hideContextMenu()"
                   :class="viewMode === 'grid' ? 'active' : ''">
                    Grid
                </a>
            </li>
        </div>
    </template>
</div>
