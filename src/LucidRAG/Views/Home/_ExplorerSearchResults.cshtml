@* Explorer Search Results - Semantic search results (no chat synthesis) *@

<div class="flex-1 overflow-auto">
    <!-- Query decomposition indicator -->
    <div x-show="queryDecomposition.length > 1" class="px-4 py-2 bg-base-200 border-b border-base-300">
        <span class="text-xs text-base-content/60">Query expanded to:</span>
        <div class="flex flex-wrap gap-1 mt-1">
            <template x-for="(sub, index) in queryDecomposition" :key="index">
                <span class="badge badge-sm badge-outline" x-text="sub"></span>
            </template>
        </div>
    </div>

    <!-- Back to browse -->
    <div class="px-4 py-2 border-b border-base-300 flex items-center justify-between bg-base-100">
        <span class="text-sm text-base-content/70">
            <span x-text="searchResults.length"></span> results for "<span x-text="searchQuery" class="font-medium"></span>"
        </span>
        <button class="btn btn-ghost btn-xs" @@click="clearSearch()">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            Clear search
        </button>
    </div>

    <!-- No results -->
    <template x-if="searchResults.length === 0">
        <div class="flex flex-col items-center justify-center py-12 text-base-content/50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <p>No matching documents found</p>
            <p class="text-sm mt-1">Try different keywords or broaden your search</p>
        </div>
    </template>

    <!-- Results list -->
    <div class="divide-y divide-base-300">
        <template x-for="result in searchResults" :key="result.id">
            <div class="p-4 hover:bg-base-200 cursor-pointer flex items-start gap-4"
                 @@click="openDocument(result.id)">
                <!-- Type icon -->
                <div class="shrink-0 mt-1" x-html="getFileIcon(result)"></div>

                <!-- Content -->
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-medium truncate" x-text="result.name"></span>
                        <span class="badge badge-xs badge-ghost" x-text="result.type"></span>
                        <span class="text-xs text-base-content/50" x-text="formatSize(result.fileSizeBytes)"></span>
                    </div>

                    <!-- Section/page info -->
                    <template x-if="result.sectionTitle">
                        <p class="text-xs text-base-content/60 mt-0.5">
                            Section: <span x-text="result.sectionTitle"></span>
                        </p>
                    </template>

                    <!-- Matched segment snippet -->
                    <template x-if="result.matchedSegments?.length > 0">
                        <p class="text-sm text-base-content/70 mt-2 line-clamp-3"
                           x-text="result.matchedSegments[0]"></p>
                    </template>

                    <!-- Meta row -->
                    <div class="flex items-center gap-3 mt-2 text-xs text-base-content/50">
                        <span x-text="formatDate(result.createdAt)"></span>
                        <span class="badge badge-xs" :class="getStatusClass(result.status)" x-text="result.status"></span>
                    </div>
                </div>

                <!-- Score indicator -->
                <div class="shrink-0 flex flex-col items-center">
                    <div class="radial-progress text-primary text-xs"
                         :style="`--value: ${Math.round(result.score * 100)}; --size: 2.5rem; --thickness: 3px;`"
                         role="progressbar">
                        <span class="text-xs font-medium" x-text="Math.round(result.score * 100)"></span>
                    </div>
                    <span class="text-xs text-base-content/50 mt-1">match</span>
                </div>
            </div>
        </template>
    </div>
</div>
