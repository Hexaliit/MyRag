<!DOCTYPE html>
<html lang="en" data-theme="light">
<script>
    // Apply saved theme immediately to prevent flash
    (function () {
        const savedTheme = localStorage.getItem('lucidrag-theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
    })();
</script>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>lucidRAG - Multi-Document RAG</title>

    <link rel="icon" type="image/svg+xml" href="~/img/logo.svg"/>
    <link rel="icon" type="image/png" href="~/img/icon.png"/>
    <link rel="apple-touch-icon" href="~/img/icon.png"/>

    <!-- Raleway font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

    <!-- Tailwind CSS + DaisyUI (compiled) -->
    <link href="~/css/dist/main.css" rel="stylesheet" type="text/css"/>

    <!-- FilePond for file uploads -->
    <link href="https://unpkg.com/filepond/dist/filepond.min.css" rel="stylesheet"/>
    @* <link href="https://unpkg.com/filepond-plugin-file-poster/dist/filepond-plugin-file-poster.min.css" *@
    @* <link href="~/css/filepond-plugin-file-poster.min.css" rel="stylesheet"/> *@
    <script src="https://unpkg.com/filepond/dist/filepond.min.js"></script>
    <script src="https://unpkg.com/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.min.js"></script>
    <script src="https://unpkg.com/filepond-plugin-file-validate-size/dist/filepond-plugin-file-validate-size.min.js"></script>

    <!-- Alpine.js -->
    @* <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script> *@
    <script defer src="~/js/cdn.min.js"></script>

    <!-- HTMX -->
    @* <script src="https://unpkg.com/htmx.org@2.0.3"></script> *@
    <script src="~/js/htmx.min.js"></script>
    @* <script src="https://unpkg.com/htmx-ext-sse@2.2.2/sse.js"></script> *@
    <script src="~/js/sse.js"></script>

    <!-- D3.js for graph visualization -->
    @* <script src="https://d3js.org/d3.v7.min.js"></script> *@
    <script src="~/js/d3.v7.min.js"></script>

    <!-- SignalR for real-time updates -->
    @* <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script> *@
    <script src="~/js/signalr.min.js"></script>

    <!-- Marked.js for markdown rendering -->
    @* <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script> *@
    <script src="~/js/marked.min.js"></script>
    <script>
        // Configure marked for safe rendering
        marked.setOptions({
            breaks: true,
            gfm: true
        });
        // Helper function for safe markdown rendering
        window.renderMarkdown = function (text) {
            if (!text) return '';
            return marked.parse(text);
        };
    </script>

    <style>
        /* Brand font - extending Tailwind */
        .font-brand {
            font-family: 'Raleway', sans-serif;
        }
    </style>
</head>
<body class="h-screen flex flex-col bg-base-200">
<!-- Header -->
<header class="navbar bg-gradient-to-r from-slate-800 to-slate-900 shadow-lg px-4">
    <div class="flex-1">
        <a href="/" class="flex items-center gap-2">
            <img src="~/img/logo.svg" alt="lucidRAG" class="h-8"/>
        </a>
    </div>
    <div class="flex-none gap-2 flex items-center">
            <a href="https://www.iseikco.com/" target="_blank"
           class="text-slate-300 hover:text-white text-sm font-brand transition-colors"><span
                class="italic text-[#dddddd]">Ise</span><span class="font-bold text-white">ikco</span><span class="text-slate-400">.com</span></a>
        <!--
            <a href="/scalar/v1" target="_blank" class="btn btn-ghost btn-sm text-slate-300 hover:text-white">API Docs</a>
        -->
        <label class="swap swap-rotate btn btn-ghost btn-sm text-slate-300 hover:text-white">
            <input type="checkbox" class="theme-controller" value="dark"/>
            <svg class="swap-on h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path
                    d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Z"/>
            </svg>
            <svg class="swap-off h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path
                    d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/>
            </svg>
        </label>
    </div>
</header>

<!-- Main content -->
<main class="flex-1 flex overflow-hidden">
    @RenderBody()
</main>

@await RenderSectionAsync("Scripts", false)

<script>
    // Theme persistence
    (function () {
        const savedTheme = localStorage.getItem('lucidrag-theme') || 'light';
        const themeCheckbox = document.querySelector('.theme-controller');
        if (themeCheckbox) {
            themeCheckbox.checked = savedTheme === 'dark';
            themeCheckbox.addEventListener('change', function () {
                const newTheme = this.checked ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', newTheme);
                localStorage.setItem('lucidrag-theme', newTheme);
            });
        }
    })();

</script>
</body>
</html>
