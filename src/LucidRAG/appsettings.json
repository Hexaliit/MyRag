  //"TenantDatabase": {
  //  "Provider": "Oracle",
  //  "ConnectionString": "User Id=raguser;Password=ragpassword;Data Source=localhost:1521/FREEPDB1",
  //  "SeedOnStartup": true,
  //  "DefaultTenantId": "default",
  //  "DefaultTenantName": "Default Tenant",
  //  "SchemaName": "RAGUSER"
  //},

  // "ConnectionString": "User Id=raguser;Password=ragpassword;Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=ORCLPDB1)))"
  "TenantDatabase": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=ragdocs.db",
    "SeedOnStartup": true,
    "DefaultTenantId": "default",
    "DefaultTenantName": "Default Tenant"
  },
  "Sentinel": {
    "Enabled": true,
    "TinyModel": "gemma3:1b",
    "EscalationModel": "qwen3:8b",
    "OllamaBaseUrl": "http://localhost:11434",
    "MaxTokens": 1024,
    "Temperature": 0.1,
    "ClarificationThreshold": 0.4,
    "CachePlans": true,
    "PlanCacheTtl": "00:15:00"
  },
  "Anthropic": {
    "ApiKey": "${ANTHROPIC_API_KEY}",
    "Model": "claude-3-5-haiku-latest",
    "MaxTokens": 4096,
    "Temperature": 0.3
  },
  "OpenAI": {
    "ApiKey": "${OPENAI_API_KEY}",
    "Model": "gpt-4o-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "MaxTokens": 4096,
    "Temperature": 0.3
  },
  "Prompts": {
    "SystemPrompts": {
      "Default": "You are a helpful assistant that answers questions based on the provided documents. Always cite your sources using [1], [2], etc.",
      "Technical": "You are a technical documentation expert. Provide precise, code-focused answers with examples. Always cite sources.",
      "Research": "You are a research assistant. Provide comprehensive analysis with multiple perspectives. Always cite sources.",
      "Concise": "You are a concise assistant. Provide brief, direct answers in 1-2 sentences. Always cite sources."
    },
    "QueryClarification": {
      "Enabled": true,
      "AmbiguityThreshold": 0.7
    },
    "QueryDecomposition": {
      "Enabled": true,
      "MaxSubQueries": 5
    },
    "SelfCorrection": {
      "Enabled": true,
      "MaxRetries": 2
    },
    "ResponseSynthesis": {
      "IncludeSources": true,
      "MaxSourcesPerResponse": 10
    }
  },
  "Lenses": {
    "Directory": "./manifests/lenses",
    "DefaultLens": "blog",
    "EnableHotReload": false
  },
  "Waves": {
    "Directory": "./manifests/waves"
  },
  "Processors": {
    "Directory": "./manifests/processors"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "RrfWeights": {
    "RrfK": 60,
    "Hybrid": {
      "Dense": 1.0,
      "Bm25": 1.0,
      "Salience": 0.3,
      "Freshness": 0.2,
      "Domain": 1.5,
      "Venue": 0.8
    },
    "Keyword": {
      "Dense": 0.3,
      "Bm25": 1.5,
      "Salience": 0.2,
      "Freshness": 0.1,
      "Domain": 0.5,
      "Venue": 0.3
    }
  },
  "Embedding": {
    "Provider": "LMStudio",
    "Model": "text-embedding-nomic-embed-text-v1.5",
    "LmStudio": {
      "DefaultEmbeddingModel": "text-embedding-nomic-embed-text-v1.5",
      "PreferredEmbeddingModels": ["text-embedding-nomic-embed-text-v1.5"],
      "AutoDiscover": true,
      "BatchSize": 32,
      "MaxTokens": 8192
    }
  },
  "LmStudio": {
    "BaseUrl": "http://models.iseikco.com:1234/",
    //    "BaseUrl": "http://models.iseikco.com:1234",
    "ApiKey": "",
    "ChatModel": "openai/gpt-oss-20b",
    "EmbeddingModel": "text-embedding-nomic-embed-text-v1.5",
    "EmbeddingDimension": 768,
    "TimeoutSeconds": 1200,
    "MaxRetries": 3,
    "Temperature": 0.3,
    "MaxTokens": 8192,
    "AutoDiscoverModels": false,
    "PreferredEmbeddingModels": [ "text-embedding-nomic-embed-text-v1.5" ],
    "DefaultEmbeddingModel": "text-embedding-nomic-embed-text-v1.5"
  }
}
