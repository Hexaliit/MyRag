{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=lucidresearch.db"
  },
  "DocSummarizer": {
    "EmbeddingBackend": "Onnx",
    "BertRag": {
      "VectorStore": "InMemory"
    }
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/lucidresearch-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
