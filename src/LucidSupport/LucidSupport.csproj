<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>LucidSupport</RootNamespace>
        <AssemblyName>lucidsupport</AssemblyName>
        <Version>0.1.0</Version>
        <Authors>Scott Galloway</Authors>
        <Description>Page-aware support assistant that learns web pages via Playwright and provides contextual help</Description>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- ASP.NET Core for serve command -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <!-- Static content for demo site + support files -->
    <ItemGroup>
        <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="support-files\**\*" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!-- Enable test access -->
    <ItemGroup>
        <InternalsVisibleTo Include="LucidSupport.Tests"/>
    </ItemGroup>

    <!-- CLI dependencies -->
    <ItemGroup>
        <PackageReference Include="Spectre.Console" Version="0.54.0"/>
        <PackageReference Include="Spectre.Console.Cli" Version="0.53.1"/>
        <PackageReference Include="Microsoft.Playwright" Version="1.58.0"/>
        <PackageReference Include="YamlDotNet" Version="16.3.0"/>
        <PackageReference Include="Markdig" Version="0.44.0"/>
    </ItemGroup>

    <!-- Core references -->
    <ItemGroup>
        <ProjectReference Include="..\DoomSummarizer.Core\DoomSummarizer.Core.csproj"/>
    </ItemGroup>

</Project>
