{
  "name": "@lucidsupport/widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:loader && npm run build:widget",
    "build:loader": "esbuild loader.ts --bundle --minify --format=iife --outfile=../wwwroot/widget/loader.js --sourcemap",
    "build:widget": "esbuild widget.ts --bundle --minify --format=esm --outfile=../wwwroot/widget/widget.js --sourcemap",
    "watch": "npm run watch:loader & npm run watch:widget",
    "watch:loader": "esbuild loader.ts --bundle --format=iife --outfile=../wwwroot/widget/loader.js --sourcemap --watch",
    "watch:widget": "esbuild widget.ts --bundle --format=esm --outfile=../wwwroot/widget/widget.js --sourcemap --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
