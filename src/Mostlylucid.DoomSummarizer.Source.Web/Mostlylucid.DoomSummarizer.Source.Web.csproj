<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks Condition="'$(UseNuGetDependency)' == 'true'">net8.0;net9.0;net10.0</TargetFrameworks>
        <TargetFramework Condition="'$(UseNuGetDependency)' != 'true'">net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>DoomSummarizer.Sources.Web</RootNamespace>

        <!-- NuGet -->
        <IsPackable>true</IsPackable>
        <PackageId>Mostlylucid.LucidRAG.Sources.Web</PackageId>
        <Authors>Scott Galloway</Authors>
        <Company>Mostlylucid</Company>
        <Description>Web search and scraping source plugin for DoomSummarizer. Includes Brave, Serper, Tavily, Jina, DuckDuckGo, and generic URL fetching.</Description>
        <PackageTags>doomsummarizer;plugin;source;web;search;scraping</PackageTags>
        <RepositoryUrl>https://github.com/scottgal/lucidrag</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <!-- Symbols -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>

        <!-- Deterministic builds -->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- MinVer -->
    <PropertyGroup>
        <MinVerTagPrefix>srcwebv</MinVerTagPrefix>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <!-- Release config -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <!-- MinVer package -->
    <ItemGroup>
        <PackageReference Include="MinVer" Version="8.0.0-alpha.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Core dependency: ProjectRef local, PackageRef for NuGet builds -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\DoomSummarizer.Core\DoomSummarizer.Core.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.LucidRAG.DoomSummarizer.Core" Version="$(CorePackageVersion)" />
    </ItemGroup>

</Project>
