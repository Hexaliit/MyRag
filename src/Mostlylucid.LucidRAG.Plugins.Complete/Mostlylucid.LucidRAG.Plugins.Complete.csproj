<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks Condition="'$(UseNuGetDependency)' == 'true'">net8.0;net9.0;net10.0</TargetFrameworks>
        <TargetFramework Condition="'$(UseNuGetDependency)' != 'true'">net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Mostlylucid.LucidRAG.Plugins.Complete</RootNamespace>

        <!-- NuGet -->
        <IsPackable>true</IsPackable>
        <PackageId>Mostlylucid.LucidRAG.Plugins.Complete</PackageId>
        <Authors>Scott Galloway</Authors>
        <Company>Mostlylucid</Company>
        <Description>Meta-package bundling all DoomSummarizer processor plugins: Books, Video, Image, Audio, and Data. Install this for the full plugin experience.</Description>
        <PackageTags>doomsummarizer;plugins;complete;books;video;image;audio;data</PackageTags>
        <RepositoryUrl>https://github.com/scottgal/lucidrag</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/release-notes.txt"))</PackageReleaseNotes>

        <!-- Symbols -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>

        <!-- Deterministic builds -->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!-- MinVer -->
    <PropertyGroup>
        <MinVerTagPrefix>plgcompv</MinVerTagPrefix>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <!-- Release config -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <!-- MinVer package -->
    <ItemGroup>
        <PackageReference Include="MinVer" Version="8.0.0-alpha.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- All processor plugins (ProjectRef local, PackageRef CI) -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\Mostlylucid.DoomSummarizer.Plugin.Books\Mostlylucid.DoomSummarizer.Plugin.Books.csproj" />
        <ProjectReference Include="..\Mostlylucid.DoomSummarizer.Plugin.Video\Mostlylucid.DoomSummarizer.Plugin.Video.csproj" />
        <ProjectReference Include="..\Mostlylucid.DoomSummarizer.Plugin.Image\Mostlylucid.DoomSummarizer.Plugin.Image.csproj" />
        <ProjectReference Include="..\Mostlylucid.DoomSummarizer.Plugin.Audio\Mostlylucid.DoomSummarizer.Plugin.Audio.csproj" />
        <ProjectReference Include="..\Mostlylucid.DoomSummarizer.Plugin.Data\Mostlylucid.DoomSummarizer.Plugin.Data.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.LucidRAG.Plugins.Books" Version="$(CorePackageVersion)" />
        <PackageReference Include="Mostlylucid.LucidRAG.Plugins.Video" Version="$(CorePackageVersion)" />
        <PackageReference Include="Mostlylucid.LucidRAG.Plugins.Image" Version="$(CorePackageVersion)" />
        <PackageReference Include="Mostlylucid.LucidRAG.Plugins.Audio" Version="$(CorePackageVersion)" />
        <PackageReference Include="Mostlylucid.LucidRAG.Plugins.Data" Version="$(CorePackageVersion)" />
    </ItemGroup>

    <!-- Package files -->
    <ItemGroup>
        <None Include=".\README.md" Pack="true" PackagePath="">
            <Link>Properties\README.md</Link>
        </None>
        <None Include=".\release-notes.txt" Pack="true" PackagePath="">
            <Link>Properties\release-notes.txt</Link>
        </None>
    </ItemGroup>

</Project>
