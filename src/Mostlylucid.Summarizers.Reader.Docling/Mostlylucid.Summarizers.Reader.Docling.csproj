<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Mostlylucid.Summarizers.Reader.Docling</RootNamespace>

        <IsPackable>true</IsPackable>
        <PackageId>Mostlylucid.Summarizers.Reader.Docling</PackageId>
        <Authors>Scott Galloway</Authors>
        <Company>Mostlylucid</Company>
        <Description>Docling-based document reader for the Summarizers pipeline. Enhanced OCR, layout analysis, and table extraction via Docling service. Supports PDF, DOCX, and scanned documents.</Description>
        <PackageTags>docling;reader;summarizer;ocr;layout;document-processing</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\DoomSummarizer.Core\DoomSummarizer.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="reader.yaml" />
    </ItemGroup>

</Project>
