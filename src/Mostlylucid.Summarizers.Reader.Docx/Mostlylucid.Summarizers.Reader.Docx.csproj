<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Mostlylucid.Summarizers.Reader.Docx</RootNamespace>

        <IsPackable>true</IsPackable>
        <PackageId>Mostlylucid.Summarizers.Reader.Docx</PackageId>
        <Authors>Scott Galloway</Authors>
        <Company>Mostlylucid</Company>
        <Description>DOCX document reader for the Summarizers pipeline. Heading-aware extraction with lists, tables, and formatting using DocumentFormat.OpenXml.</Description>
        <PackageTags>docx;reader;summarizer;openxml;document-processing</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DocumentFormat.OpenXml" Version="3.4.1" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\DoomSummarizer.Core\DoomSummarizer.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="reader.yaml" />
    </ItemGroup>

</Project>
