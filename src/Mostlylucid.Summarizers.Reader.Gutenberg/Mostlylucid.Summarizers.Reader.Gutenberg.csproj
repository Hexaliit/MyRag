<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Mostlylucid.Summarizers.Reader.Gutenberg</RootNamespace>

        <IsPackable>true</IsPackable>
        <PackageId>Mostlylucid.Summarizers.Reader.Gutenberg</PackageId>
        <Authors>Scott Galloway</Authors>
        <Company>Mostlylucid</Company>
        <Description>Project Gutenberg archive reader for the Summarizers pipeline. Handles ZIP/TXT files with header/footer stripping and metadata extraction.</Description>
        <PackageTags>gutenberg;reader;summarizer;ebook;text;document-processing</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\DoomSummarizer.Core\DoomSummarizer.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="reader.yaml" />
    </ItemGroup>

</Project>
