<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <RootNamespace>VideoSummarizer.Core</RootNamespace>
    <AssemblyName>VideoSummarizer.Core</AssemblyName>

    <!-- Package metadata -->
    <PackageId>VideoSummarizer.Core</PackageId>
    <Description>Core video analysis pipeline with shot detection, scene segmentation, OCR tracking, and speech transcription</Description>
    <Authors>Scott Galloway</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/scottgal/lucidrag</PackageProjectUrl>
    <RepositoryUrl>https://github.com/scottgal/lucidrag</RepositoryUrl>
    <PackageTags>video;shot-detection;scene-segmentation;ocr;whisper;clip;onnx;ffmpeg</PackageTags>
  </PropertyGroup>

  <!-- Release configuration: no PDB files -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Common pipeline abstractions -->
    <ProjectReference Include="..\Mostlylucid.Summarizer.Core\Mostlylucid.Summarizer.Core.csproj" />
    <!-- Image analysis for keyframe processing (CLIP, OCR, vision) -->
    <ProjectReference Include="..\ImageSummarizer.Core\ImageSummarizer.Core.csproj" />
    <!-- Audio analysis for transcription (Whisper, diarization) -->
    <ProjectReference Include="..\AudioSummarizer.Core\AudioSummarizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FFmpeg for video processing -->
    <PackageReference Include="Xabe.FFmpeg" Version="5.2.6" />

    <!-- OpenCV for frame analysis and shot detection -->
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />

    <!-- YAML for wave configuration -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Config\*.json" />
    <EmbeddedResource Include="Waves\*.wave.yaml" />
  </ItemGroup>

</Project>
